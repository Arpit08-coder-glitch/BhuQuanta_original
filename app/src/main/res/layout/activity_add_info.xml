<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop Data Submission Form"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#363A96"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Current Date and Time with Icon -->
        <TextView
            android:id="@+id/tvDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Date and Time"
            android:textSize="16sp"
            android:layout_marginTop="40dp"
            android:background="#f1f1f1"
            android:padding="10dp"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="10dp"
            android:textColor="#333333"
            android:textAlignment="center"/>

        <!-- Enter Crop with Icon -->
        <EditText
            android:id="@+id/etCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Crop"
            android:layout_marginTop="40dp"
            android:minHeight="48dp"
            android:textSize="16sp"
            android:drawableStart="@drawable/ic_grass"
            android:drawablePadding="10dp"/>

        <!-- Enter Crop Stage with Icon -->
        <EditText
            android:id="@+id/etCropStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Enter Crop Stage"
            android:minHeight="48dp"
            android:textSize="16sp"
            android:drawableStart="@drawable/ic_stage"
            android:drawablePadding="10dp"/>

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <!-- Upload Image Button with Icon -->
        <Button
            android:id="@+id/btnUploadImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Image"
            android:backgroundTint="#363A96"
            android:textColor="#ffffff"
            android:layout_marginTop="20dp"
            android:drawableStart="@drawable/ic_upload"
            android:drawablePadding="10dp"/>

        <!-- Submit Data Button with Icon -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Data"
            android:backgroundTint="#363A96"
            android:textColor="#ffffff"
            android:layout_marginTop="20dp"
            android:drawableStart="@drawable/ic_submit"
            android:drawablePadding="10dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
